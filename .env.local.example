# Neon Postgres connection string.
# Use a Neon development branch for local work — see Milestone A decisions.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# NextAuth v5 session/token signing secret. Generate with `npx auth secret`
# or `openssl rand -base64 33`. Required — the app throws at startup without it.
AUTH_SECRET=""
